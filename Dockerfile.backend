# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["backend/Goan.Api/Goan.Api.csproj", "backend/Goan.Api/"]
RUN dotnet restore "backend/Goan.Api/Goan.Api.csproj"
COPY backend/Goan.Api/ backend/Goan.Api/
WORKDIR "/src/backend/Goan.Api"
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:5080
EXPOSE 5080
ENTRYPOINT ["dotnet", "Goan.Api.dll"]
